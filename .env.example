# Copy to .env.local and fill in. Never commit .env.local.

# Absolute origin of the deployed site, used for canonical URLs, Open Graph tags, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Signs session cookies. At least 32 random characters, e.g. `openssl rand -hex 32`.
TENTACT_AUTH_SECRET=

# Accounts allowed to sign in: `email:passwordHash` or `email:passwordHash:Workspace name`
# entries separated by `;`. Without a workspace name one is derived from the email domain.
# Generate hashes with `node scripts/hash-password.mjs`.
TENTACT_AUTH_ACCOUNTS=
