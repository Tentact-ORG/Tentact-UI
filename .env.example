# The Tentact — environment configuration.
# Copy to .env (or .env.local) and fill in. Never commit the copy: both are git-ignored.
# Every variable is documented in docs/environment_variables.md.

# --- Site -------------------------------------------------------------------
# Absolute origin of the deployed site: canonical URLs, Open Graph tags, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Sign-in ----------------------------------------------------------------
# Signs dashboard session cookies. At least 32 random characters: `openssl rand -base64 48`.
TENTACT_AUTH_SECRET=
# Signs Bearer tokens for API clients (/api/auth/login). At least 32 random characters.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# "production" enforces a unique JWT_SECRET_KEY; "test" disables background workers.
APP_ENV=development
LOG_LEVEL=INFO

# --- Application database ---------------------------------------------------
# Users, organizations, saved searches, lists, exports and the audit log.
# SQLite:   sqlite:///./leadgen_app.db
# Postgres: postgresql://postgres:postgres_secure_pass@localhost:5432/leadgen_app
DATABASE_URL=sqlite:///./leadgen_app.db

# --- ClickHouse lead warehouse ----------------------------------------------
# 'client' for a real server, 'mock' for the offline synthetic dataset.
CLICKHOUSE_MODE=client
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=leadgen_warehouse
CLICKHOUSE_SECURE=false
# Set to false only for self-signed TLS certificates on a trusted network.
CLICKHOUSE_VERIFY=true
CLICKHOUSE_CONNECT_TIMEOUT_SEC=10
CLICKHOUSE_QUERY_TIMEOUT_SEC=30

# --- LLM (SQL generator and reviewer agents) --------------------------------
# Providers: mock, azure, azure-anthropic, groq, openai, anthropic, gemini.
LLM_PROVIDER=mock
# Optional: a different provider for the SQL reviewer agent, for an independent check
# (e.g. azure-anthropic while the generator runs on azure). Empty = LLM_PROVIDER.
LLM_REVIEWER_PROVIDER=
LLM_MODEL=mock-advanced-sql
LLM_TEMPERATURE=0.0
# Reasoning deployments (e.g. Azure gpt-5-mini) need more than the default 25 s.
LLM_TIMEOUT_SEC=60

# Azure OpenAI (LLM_PROVIDER=azure). Check the setup with `npm run verify-azure`.
# The v1 endpoint of the Azure AI Foundry / Azure OpenAI resource:
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# The deployment name (not the model name) chosen when the model was deployed.
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# Reasoning deployments only: minimal | low | medium | high. Leave empty for other models.
AZURE_OPENAI_REASONING_EFFORT=medium
AZURE_OPENAI_REVIEWER_REASONING_EFFORT=low
# Only sent when set; reasoning deployments accept nothing but the default.
AZURE_OPENAI_TEMPERATURE=

# Claude on Azure AI Foundry (provider azure-anthropic). Endpoint and key default to the
# AZURE_OPENAI_* resource above; set them only for a different Foundry resource.
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
# The Claude deployment name on the resource, e.g. claude-haiku-4-5.
AZURE_ANTHROPIC_DEPLOYMENT=

# Other providers (set the key matching LLM_PROVIDER).
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Credits ------------------------------------------------------------------
# Revealing or exporting a contact's email/phone costs credits, once per contact and workspace.
CREDITS_ENABLED=true
CREDITS_PER_CONTACT=1
# Comma-separated emails of platform operators who approve top-up requests and grant credits.
# Credits can also be granted from the command line: npm run grant-credits -- --org-slug <slug> --credits <n>
CREDITS_OPERATOR_EMAILS=

# --- Exports and CORS -------------------------------------------------------
EXPORT_MAX_ROWS=100000
EXPORT_EXPIRATION_HOURS=24
EXPORT_STORAGE_PATH=./exports_storage
# Origins allowed to call /api/* cross-origin (the dashboard itself is same-origin).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
