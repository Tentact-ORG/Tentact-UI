{
  "name": "tentact-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && next dev --webpack",
    "build": "node api.js && next build --webpack",
    "start": "node api.js && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap-admin": "tsx --env-file-if-exists=.env scripts/bootstrap-admin.ts",
    "seed-clickhouse": "tsx --env-file-if-exists=.env scripts/seed-clickhouse.ts",
    "generate-data": "tsx scripts/generate-synthetic-data.ts",
    "verify-azure": "tsx --env-file-if-exists=.env scripts/verify-azure.ts",
    "migrate-db": "tsx --env-file-if-exists=.env scripts/migrate-db.ts",
    "discover-warehouse": "tsx --env-file-if-exists=.env scripts/discover-warehouse.ts",
    "grant-credits": "tsx --env-file-if-exists=.env scripts/grant-credits.ts",
    "migrate-supabase": "tsx --env-file-if-exists=.env scripts/migrate-supabase.ts",
    "verify-public-search-limit": "tsx --env-file-if-exists=.env scripts/verify-public-search-limit.ts"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^1.1.0",
    "@anthropic-ai/sdk": "^1.3.0",
    "@clickhouse/client": "^1.24.1",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "d3-geo": "^3.1.1",
    "jose": "^6.2.13",
    "kysely": "^0.29.7",
    "lenis": "^1.1.13",
    "motion": "^11.18.2",
    "next": "^16.4.2",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
